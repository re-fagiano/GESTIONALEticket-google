{
  "name": "ticket-gestionale",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.10.0",
    "npm": "^10.5.0"
  },
  "packageManager": "npm@10.5.0",
  "scripts": {
    "preinstall": "npm cache clean --force && npm config set registry https://registry.npmjs.org/ && npm config set fetch-retries=5 && npm config set prefer-offline=false",
    "dev": "vite",
    "build": "prisma generate && node scripts/check-duplicate-intervention-handlers.js && vite build",
    "start": "npm run prisma:deploy && node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "echo \"No tests configured\"",
    "start:sqlite": "npm run build && node backend/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4"
  }
}
