{
  "name": "ticket-gestionale",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "vite",
    "build": "prisma generate && vite build",
    "start": "pnpm prisma migrate deploy || true && node server.js",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "lint": "eslint .",
    "test": "echo \"No tests configured\"",
    "clean": "rm -rf dist .vite",
    "preview": "vite preview",
    "prisma:migrate": "prisma migrate dev",
    "check:icons": "node scripts/check-icon-usage.js",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:static": "node scripts/security-static-check.js",
    "security:ci": "pnpm security:static && pnpm security:audit"
  },
  "dependencies": {
    "@prisma/client": "5",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.8.0",
    "prisma": "5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
