# Variabili critiche obbligatorie per avvio backend sicuro.
# Rollback: rendere opzionali in server.js/config.js se vuoi consentire avvio best-effort.
DATABASE_URL=postgresql://user:password@localhost:5432/gestionale
JWT_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret
API_TOKEN=replace_with_api_token

# Seed admin sicuro (niente credenziali hardcoded nel codice).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# Integrazioni opzionali
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
RAG_API_URL=
PORT=3000
NODE_ENV=development
