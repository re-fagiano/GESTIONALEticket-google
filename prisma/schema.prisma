generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InterventionType {
  chiamata
  riparazione
  ordine_ricambi
  preventivo
}

enum InterventionStatus {
  pendente
  in_lavorazione
  completato
  annullato
}

// Ruoli unificati per evitare alias legacy tra backend e token JWT.
// Rollback: reintrodurre i vecchi valori enum e migrare i record esistenti.
enum UserRole {
  ADMIN
  OPERATOR
  READER
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  interventions Intervention[]
  tickets       Ticket[]
  calendarItems CalendarItem[]

  @@index([name])
  @@map("customers")
}

model Ticket {
  id          String    @id @default(uuid())
  subject     String
  description String?
  status      String    @default("aperto")
  date        String?
  time        String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("tickets")
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  location  String?
  qty       Int      @default(0)
  price     Float    @default(0)
  minQty    Int      @default(0)
  priceDate String?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model Intervention {
  id             String             @id @default(uuid())
  code           String             @unique
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type           InterventionType
  status         InterventionStatus @default(pendente)
  priority       Int                @default(2)
  assignedToId   String?
  assignedTo     User?              @relation("InterventionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  description    String?
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  additionalData Json?
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  notes          Note[]
  calendarItems  CalendarItem[]
  logs           InterventoLog[]

  @@index([assignedToId])

  @@index([customerId])
  @@index([status])
  @@map("interventions")
}

model CalendarItem {
  id             String        @id @default(uuid())
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  status         String?       @default("planned")
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  interventionId String?
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([startAt, endAt])
  @@map("calendar_items")
}

model Note {
  id             String       @id @default(uuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("notes")
}


model InterventoLog {
  id           String       @id @default(uuid())
  interventoId String
  intervento   Intervention @relation(fields: [interventoId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  note         String?
  createdAt    DateTime     @default(now())

  @@index([interventoId, createdAt])
  @@map("intervento_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  operatorCode String   @unique
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  assignedInterventions   Intervention[] @relation("InterventionAssignee")
  interventoLogs          InterventoLog[]

  @@index([role])
  @@map("users")
}
